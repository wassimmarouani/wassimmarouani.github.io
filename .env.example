# Copy to .env for local development. Both values are optional.

# Web3Forms access key (https://web3forms.com). Public by design: it only allows
# sending messages to the inbox it was created for. Without it, the contact form
# opens the visitor's email app instead.
PUBLIC_WEB3FORMS_KEY=

# Public URL of the site. Defaults to https://wassimmarouani.github.io
# SITE_URL=https://wassimmarouani.github.io

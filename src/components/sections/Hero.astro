---
import { Picture } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import CvButton from '@/components/CvButton.astro';
import { profile } from '@/data/profile';
import { heroPhoto, heroPhotoSizes, heroPhotoWidths } from '@/lib/hero-photo';
import { localePath, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <svg
    class="hero-network flip-rtl pointer-events-none absolute -end-24 top-0 hidden h-full w-[34rem] text-accent opacity-60 lg:block"
    viewBox="0 0 540 460"
    fill="none"
    aria-hidden="true"
  >
    <g stroke="var(--c-border)" stroke-width="1.25">
      <path d="M60 80 L190 140 L330 70 L470 130 M190 140 L240 290 L400 250 L470 130 M240 290 L120 380 M400 250 L500 380" />
    </g>
    <g fill="var(--c-bg)" stroke="var(--c-border-strong)" stroke-width="1.25">
      <circle cx="60" cy="80" r="4" />
      <circle cx="330" cy="70" r="4" />
      <circle cx="470" cy="130" r="4" />
      <circle cx="240" cy="290" r="4" />
      <circle cx="400" cy="250" r="4" />
      <circle cx="120" cy="380" r="4" />
      <circle cx="500" cy="380" r="4" />
    </g>
    <circle cx="190" cy="140" r="26" fill="currentColor" opacity="0.12" class="hero-glow" />
    <circle cx="190" cy="140" r="5.5" fill="currentColor" />
  </svg>

  <div class="page relative grid items-center gap-10 pt-12 pb-16 md:grid-cols-[1fr_auto] md:gap-14 md:pt-20 md:pb-24">
    <div class="order-2 md:order-1">
      <h1 id="hero-title" class="text-3xl tracking-tight md:text-4xl">{profile.name[locale]}</h1>
      <p class="mt-3 text-lg font-medium text-accent md:text-xl">{profile.headline[locale]}</p>
      <p class="prose-width mt-5 text-lg text-text">{profile.tagline[locale]}</p>

      <p class="mt-6 flex items-start gap-2.5 text-muted">
        <Icon name="briefcase" size={18} class="mt-1" />
        <span>{profile.availabilityShort[locale]}</span>
      </p>
      <p class="mt-2 flex items-start gap-2.5 text-muted">
        <Icon name="mapPin" size={18} class="mt-1" />
        <span>{profile.location[locale]}</span>
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`${localePath(locale)}#projects`} class="btn btn-primary">{t('hero.viewProjects')}</a>
        <CvButton locale={locale} variant="secondary" />
      </div>

      <ul class="mt-6 flex items-center gap-1" aria-label={t('hero.elsewhere')}>
        <li>
          <a href={profile.links.linkedin} class="icon-btn -ms-3" aria-label={t('social.linkedin')} rel="me noopener">
            <Icon name="linkedin" size={22} />
          </a>
        </li>
        <li>
          <a href={profile.links.github} class="icon-btn" aria-label={t('social.github')} rel="me noopener">
            <Icon name="github" size={22} />
          </a>
        </li>
        <li>
          <a href={`mailto:${profile.email}`} class="icon-btn" aria-label={t('social.email')}>
            <Icon name="mail" size={22} />
          </a>
        </li>
      </ul>
    </div>

    <div class="order-1 md:order-2">
      <Picture
        src={heroPhoto}
        alt={t('hero.photoAlt')}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={heroPhotoWidths}
        sizes={heroPhotoSizes}
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-32 rounded-card border border-line object-cover sm:w-40 md:w-64 lg:w-72"
      />
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import { cvs } from '@/data/cv';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  variant?: 'primary' | 'secondary';
  /** Which side the options open towards. */
  align?: 'start' | 'end';
  class?: string;
}

const { locale, variant = 'secondary', align = 'end', class: className = '' } = Astro.props;
const t = useTranslations(locale);
const single = cvs.length === 1 ? cvs[0] : undefined;
---

{
  single && (
    <a href={single.href} download class:list={['btn', `btn-${variant}`, className]}>
      <Icon name="download" size={18} />
      {t('cv.download')}
    </a>
  )
}
{
  cvs.length > 1 && (
    <details class:list={['cv-menu relative', className]} data-cv-menu>
      <summary class:list={['btn', `btn-${variant}`, 'list-none [&::-webkit-details-marker]:hidden']}>
        <Icon name="download" size={18} />
        {t('cv.download')}
        <Icon name="chevronDown" size={16} class="cv-chevron transition-transform" />
      </summary>
      <ul
        class:list={[
          'absolute top-full z-30 mt-2 w-72 rounded-md border border-line bg-surface p-1.5 shadow-lg shadow-black/10',
          align === 'end' ? 'end-0' : 'start-0',
        ]}
      >
        {cvs.map((cv) => (
          <li>
            <a
              href={cv.href}
              download
              class="flex min-h-11 items-center gap-3 rounded px-3 py-2 text-text no-underline hover:bg-accent-soft"
            >
              <Icon name="fileText" size={18} class="text-accent" />
              <span class="flex flex-col">
                <span class="font-medium">{t(cv.label)}</span>
                <span class="text-sm text-muted">{t('cv.note')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .cv-menu[open] :global(.cv-chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  // Close open CV menus on outside click or Escape.
  const menus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-cv-menu]');

  document.addEventListener('click', (event) => {
    for (const menu of menus()) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus()) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
